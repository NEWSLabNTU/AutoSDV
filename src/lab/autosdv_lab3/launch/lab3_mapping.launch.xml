<?xml version="1.0"?>
<!--
  Lab 3, week 1: the stack for the mapping drive.

      ros2 launch autosdv_lab3 lab3_mapping.launch.xml vehicle_id:=car_b

  The sensors as on any drive (LiDAR, ZED with its IMU, the IMU corrector, wheel
  speed) and the vehicle description's TF, for `ros2 bag record` in a second
  terminal (config/record/map_topics.txt). No map, no localization, no planning:
  there is no map yet. The actuator is a dry run (it never writes the PCA9685):
  drive with the transmitter, the selector switch on the joystick.
-->
<launch>
  <arg name="vehicle_id"
       description="REQUIRED: car_a, car_b or car_c (individual_params/config/VEHICLE_ID)"/>
  <!-- Autoware's model tree: autosdv_launch's default is ./data/autoware_data, relative to
       the working directory, so a launch from anywhere but the checkout's root fails on a
       missing file. This one resolves from the installed workspace (isolated install:
       install/autosdv_launch/share/autosdv_launch is four levels below the root). -->
  <arg name="data_path"
       default="$(env AUTOSDV_DATA_PATH $(find-pkg-share autosdv_launch)/../../../../data/autoware_data)"
       description="Autoware's model directory (just setup-autoware-data writes it)"/>
  <arg name="rviz" default="false"/>

  <!-- The ZED must never see a DISPLAY, nor VirtualGL's faker in LD_PRELOAD: from a VNC
       desktop's terminal it would stop at "CAMERA OPENING" (scripts/camera_display.sh says
       why). Taken out of this launch's environment, so a plain ros2 launch from any
       terminal opens the camera. -->
  <unset_env name="DISPLAY"/>
  <unset_env name="LD_PRELOAD"/>

  <let name="launch_vehicle_interface" value="false"/>
  <let name="launch_pointcloud_preprocessor" value="false"/>
  <let name="launch_gyro_bias_estimator" value="false"/>

  <group scoped="true">
    <let name="rviz" value="false"/>
    <include file="$(find-pkg-share autosdv_launch)/launch/autosdv.launch.yaml">
      <arg name="vehicle_id" value="$(var vehicle_id)"/>
      <arg name="data_path" value="$(var data_path)"/>
      <arg name="use_gnss" value="false"/>
      <arg name="use_ntrip" value="false"/>
      <arg name="launch_map" value="false"/>
      <arg name="launch_localization" value="false"/>
      <arg name="launch_perception" value="false"/>
      <arg name="launch_planning" value="false"/>
      <arg name="launch_control" value="false"/>
      <arg name="launch_system_monitor" value="false"/>
      <arg name="launch_system" value="false"/>
      <arg name="launch_api" value="false"/>
      <arg name="launch_shared_pointcloud_container" value="false"/>
      <arg name="launch_empty_objects_publisher" value="false"/>
      <arg name="is_simulation" value="true"/>
    </include>
  </group>

  <!-- wheel speed (lab3_check_bag's speed and standing-still checks); the
       actuator as a dry run, never driving -->
  <include file="$(find-pkg-share autosdv_vehicle_launch)/launch/vehicle_interface.launch.xml">
    <arg name="launch_vehicle_interface" value="true"/>
    <arg name="is_simulation" value="true"/>
    <arg name="launch_signal_manager" value="false"/>
    <arg name="vehicle_id" value="$(var vehicle_id)"/>
  </include>
</launch>
