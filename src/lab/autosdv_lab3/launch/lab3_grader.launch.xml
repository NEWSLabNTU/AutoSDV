<?xml version="1.0"?>
<!--
  Lab 3, week 2: the grader of one autonomous lap.

      ros2 launch autosdv_lab3 lab3_grader.launch.xml out_dir:=$PWD/lab3/bags map_path:=$PWD/lab3/map

  Start it after the stack (lab3/run.sh: autosdv.launch.yaml on map_path) and before
  setting the goal. It also starts lab3_run_meta on map_path: the latched /lab3/run_meta
  that puts the lanelet2 file and the map's hash into the bag, from which the grade reads
  the loop (map_path must be the folder the stack was launched with). It records
  the run topics (config/record/run_topics.txt) into <out_dir>/run_<date>_<time>;
  Ctrl-C after the car has stopped ends the recording, grades the bag and prints the
  result, also written to grade.yaml in the bag. The grade reads only the bag:
  `ros2 run autosdv_lab3 lab3_grade BAG` repeats it anywhere.
-->
<launch>
  <arg name="out_dir" default="$(env HOME)/lab3/bags" description="where the dated bag goes"/>
  <arg name="map_path" description="REQUIRED: the map folder the stack runs on"/>
  <arg name="vehicle_id" default="" description="recorded in run_meta, for the report only"/>
  <!-- room to stop the recorder and grade after Ctrl-C before launch escalates to SIGTERM -->
  <let name="sigterm_timeout" value="120"/>
  <node pkg="autosdv_lab3" exec="lab3_grader" name="lab3_grader" output="screen"
        args="--out-dir $(var out_dir)"/>
  <!-- latched /lab3/run_meta: the lanelet2 file and the map's hash, recorded into the bag -->
  <node pkg="autosdv_lab3" exec="lab3_run_meta" name="lab3_run_meta" output="log">
    <param name="map_path" value="$(var map_path)"/>
    <param name="vehicle_id" value="$(var vehicle_id)"/>
  </node>
</launch>
