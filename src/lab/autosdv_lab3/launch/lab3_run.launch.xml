<?xml version="1.0"?>
<!--
  Lab 3, week 2: the full stack on the team's own map.

      ros2 launch autosdv_lab3 lab3_run.launch.xml vehicle_id:=car_b map_path:=$HOME/lab3/team3_map

  NDT localizes against map_path/pointcloud_map.pcd with the classroom parameters.
  Nothing initializes it automatically: in RViz, 2D Pose Estimate at the start (the
  map origin is where the mapping recording began, so the start mark is near it),
  one 2D Goal Pose about 1.0 m behind the start, in the lanelet before the start's,
  then Auto. Planning runs with planning_profile:=rc (no reversing pull-outs, a finer
  path, the car's own curvature limit, and the changes that let one goal just behind
  the start drive the whole loop: autosdv_launch config/planning_rc/README.md).

  is_simulation, use_sim_time and replay are for lab3_replay.launch.xml (the run bag
  replayed at home) and the TA simulation; on the car leave them at their defaults.
-->
<launch>
  <arg name="vehicle_id"
       description="REQUIRED: car_a, car_b or car_c (individual_params/config/VEHICLE_ID)"/>
  <arg name="map_path" description="REQUIRED: the team's map folder"/>
  <arg name="sensor" default="$(eval &quot;'vlp16' if '$(var vehicle_id)' == 'car_a' else 'robin_w'&quot;)"
       description="the LiDAR family: vlp16 (car A) or robin_w (cars B and C, and sim)"/>
  <arg name="pose_source" default="ndt"
       description="ndt (default: reads ndt_param_file) or cuda_ndt (its own parameters)"/>
  <!-- Robin-W: its own NDT file and a denser NDT input (config/ndt_indoor_robin_w.param.yaml
       and config/localization/ say why); the VLP-16 keeps the indoor file and autosdv_launch's
       downsampling -->
  <arg name="ndt_param_file"
       default="$(find-pkg-share autosdv_lab3)/config/$(eval &quot;'ndt_indoor_robin_w' if '$(var sensor)' == 'robin_w' else 'ndt_indoor'&quot;).param.yaml"/>
  <arg name="ndt_voxel_grid_param_file"
       default="$(eval &quot;'$(find-pkg-share autosdv_lab3)/config/localization/voxel_grid_robin_w.param.yaml' if '$(var sensor)' == 'robin_w' else '$(find-pkg-share autosdv_launch)/config/localization/ndt_scan_matcher/pointcloud_preprocessor/voxel_grid_filter.param.yaml'&quot;)"/>
  <arg name="ndt_random_downsample_param_file"
       default="$(eval &quot;'$(find-pkg-share autosdv_lab3)/config/localization/random_downsample_robin_w.param.yaml' if '$(var sensor)' == 'robin_w' else '$(find-pkg-share autosdv_launch)/config/localization/ndt_scan_matcher/pointcloud_preprocessor/random_downsample_filter.param.yaml'&quot;)"/>
  <let name="ndt_voxel_grid_param_file" value="$(var ndt_voxel_grid_param_file)"/>
  <let name="ndt_random_downsample_param_file" value="$(var ndt_random_downsample_param_file)"/>
  <!-- Autoware's model tree: autosdv_launch's default is ./data/autoware_data, relative to
       the working directory, so a launch from anywhere but the checkout's root fails on a
       missing file. This one resolves from the installed workspace (isolated install:
       install/autosdv_launch/share/autosdv_launch is four levels below the root). -->
  <arg name="data_path"
       default="$(env AUTOSDV_DATA_PATH $(find-pkg-share autosdv_launch)/../../../../data/autoware_data)"
       description="Autoware's model directory (just setup-autoware-data writes it)"/>
  <arg name="is_simulation" default="false"/>
  <arg name="use_sim_time" default="false"
       description="the stack on /clock (a simulator's), which run_meta's launch time must follow"/>
  <arg name="rviz" default="false"
       description="RViz from the stack; on the car run rviz2 in its own terminal instead (no DISPLAY here)"/>
  <arg name="replay" default="false"
       description="true: no sensor drivers and no vehicle interface, the sensors come from ros2 bag play (lab3_replay.launch.xml)"/>
  <let name="launch_sensing_driver" value="false" if="$(var replay)"/>
  <let name="launch_vehicle_interface" value="false" if="$(var replay)"/>

  <!-- The ZED must never see a DISPLAY, nor VirtualGL's faker in LD_PRELOAD: from a VNC
       desktop's terminal it would stop at "CAMERA OPENING" (scripts/camera_display.sh says
       why). Taken out of this launch's environment, so a plain ros2 launch from any
       terminal opens the camera. A replay has no camera and keeps both. -->
  <unset_env name="DISPLAY" unless="$(var replay)"/>
  <unset_env name="LD_PRELOAD" unless="$(var replay)"/>

  <!-- the classroom map loaded whole by perception's compare-map filter (the file says why) -->
  <let name="pointcloud_map_filter_param_path"
       value="$(find-pkg-share autosdv_lab3)/config/pointcloud_map_filter_indoor.param.yaml"/>

  <!-- Lab 3 steers with Autoware's stock MPC: pinned here so that an inherited
       lateral_controller_mode:=... on the command line cannot switch it -->
  <let name="lateral_controller_mode" value="mpc"/>
  <include file="$(find-pkg-share autosdv_launch)/launch/autosdv.launch.yaml">
    <arg name="vehicle_id" value="$(var vehicle_id)"/>
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="pose_source" value="$(var pose_source)"/>
    <arg name="ndt_param_file" value="$(var ndt_param_file)"/>
    <arg name="planning_profile" value="rc"/>
    <arg name="use_gnss" value="false"/>
    <arg name="use_ntrip" value="false"/>
    <arg name="is_simulation" value="$(var is_simulation)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="rviz" value="$(var rviz)"/>
  </include>

  <!-- the overall speed limit, from a config file (3 km/h as shipped; at most 10): edit the
       file and save, and lab3_speed_limit applies it within a second -->
  <arg name="speed_limit_config" default="$(find-pkg-share autosdv_lab3)/config/speed_limit.yaml"
       description="YAML with max_speed_kmh, re-read on change"/>
  <node pkg="autosdv_lab3" exec="lab3_speed_limit" name="lab3_speed_limit" output="log">
    <param name="config_file" value="$(var speed_limit_config)"/>
  </node>

  <!-- latched /lab3/run_meta: launch time and the hash of the map loaded, for grading -->
  <node pkg="autosdv_lab3" exec="lab3_run_meta" name="lab3_run_meta" output="log">
    <param name="map_path" value="$(var map_path)"/>
    <param name="vehicle_id" value="$(var vehicle_id)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

</launch>
