<?xml version="1.0"?>
<!--
  Lab 3: practise the lap on your own map in the planning simulator, anywhere.

      lab3/psim.sh   (play_launch ... lab3_planning_sim.launch.xml map_path:=$PWD/lab3/map)

  AutoSDV's RC simulator (autosdv_rc_sim rc_sim.launch.xml: Autoware in planning-simulator
  mode, the car's own vehicle interface on simulated hardware, the RC car plant) on the
  team's map folder, with planning_profile:=rc, the planning files the car drives with.
  Autoware's stock planning_simulator.launch.xml loads the stock planning files, with
  which one goal just behind the start does not drive a lap (autosdv_launch
  config/planning_rc/README.md says why).

  The car appears at the map origin facing the map's +x, which is not the way the car
  faced when the mapping began (GLIM's axes follow the LiDAR's: docs/guides/lab3.md).
  Then the field procedure in RViz: 2D Pose Estimate at the start, one 2D Goal Pose
  about 1.0 m behind it in the lanelet before the start's, Auto. The overall speed limit
  is lab3_speed_limit's, as on the car (speed_limit_config, 3 km/h as shipped).

  A map folder with a track.yaml (lab3_sim_lap writes one) starts the car at its
  start_pose instead.
-->
<launch>
  <arg name="map_path" description="REQUIRED: the team's map folder"/>
  <arg name="rviz" default="true"/>
  <arg name="speed_limit_config" default="$(find-pkg-share autosdv_lab3)/config/speed_limit.yaml"
       description="YAML with max_speed_kmh, re-read on change"/>

  <include file="$(find-pkg-share autosdv_rc_sim)/launch/rc_sim.launch.xml">
    <arg name="track_dir" value="$(var map_path)"/>
    <arg name="planning_profile" value="rc"/>
    <arg name="rviz" value="$(var rviz)"/>
  </include>

  <node pkg="autosdv_lab3" exec="lab3_speed_limit" name="lab3_speed_limit" output="log">
    <param name="config_file" value="$(var speed_limit_config)"/>
    <param name="use_sim_time" value="true"/>
  </node>
</launch>
