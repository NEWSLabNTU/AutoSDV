<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autosdv_system_monitor</name>
  <version>1.0.0</version>
  <description>AutoSDV system monitoring package with web interface for ROS2 topics</description>
  
  <maintainer email="autosdv@example.com">AutoSDV Team</maintainer>
  <license>Apache-2.0</license>
  
  <author email="autosdv@example.com">AutoSDV Team</author>
  
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>autoware_vehicle_msgs</exec_depend>
  <exec_depend>autoware_control_msgs</exec_depend>
  <exec_depend>python3-flask</exec_depend>
  <exec_depend>python3-watchdog</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>