<launch>
  <arg name="launch_driver" default="false" description="Launch sensor drivers (false for rosbag replay)"/>
  <arg name="vehicle_mirror_param_file" description="path to the file of vehicle mirror position yaml"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>

  <group>
    <!-- For rosbag replay, we don't launch actual drivers -->
    <!-- The rosbag will publish to /sensing/camera/front/image and /sensing/camera/front/image/info -->
    <!-- The rosbag will also publish /localization/twist_estimator/twist_with_covariance -->

    <!-- Camera topics are provided by the rosbag, no driver needed -->
    <!-- The topics will be: -->
    <!--   /sensing/camera/front/image -->
    <!--   /sensing/camera/front/image/info -->

    <!-- Vehicle Velocity Converter -->
    <!-- This converts vehicle velocity status to twist with covariance -->
    <!-- Note: For rosbag replay, twist data comes from the bag itself at: -->
    <!--   /localization/twist_estimator/twist_with_covariance -->
    <include file="$(find-pkg-share autoware_vehicle_velocity_converter)/launch/vehicle_velocity_converter.launch.xml">
      <arg name="input_vehicle_velocity_topic" value="/vehicle/status/velocity_status"/>
      <arg name="output_twist_with_covariance" value="/sensing/vehicle_velocity_converter/twist_with_covariance"/>
    </include>
  </group>
</launch>
