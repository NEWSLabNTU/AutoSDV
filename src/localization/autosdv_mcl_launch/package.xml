<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autosdv_mcl_launch</name>
  <version>0.1.0</version>
  <description>
    Adapts the 2D-MCL particle filter's pose output into the
    PoseWithCovarianceStamped contract ekf_localizer consumes
    (mcl_pose_relay node). See docs/design/localization-method-switching.md.
  </description>
  <maintainer email="dev@autosdv.org">AutoSDV Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>python-transforms3d-pip</depend>

  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>particle_filter</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
