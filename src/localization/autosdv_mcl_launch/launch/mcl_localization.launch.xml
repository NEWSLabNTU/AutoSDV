<?xml version="1.0"?>
<!--
  autosdv_mcl_launch/launch/mcl_localization.launch.xml - Task 7.

  Turns scripts/2dlidar/run-particle-filter.sh's node lineup (minus the
  nav2_map_server bring-up, which src/launcher/autosdv_launch's
  autosdv_map_component.launch.xml already owns for pose_source:=mcl - see
  Task 1) into a real launch file: pointcloud_to_laserscan -> scan_qos_bridge
  -> particle_filter, wheel_imu_odom (velocity+IMU -> /odom), and
  mcl_pose_relay (-> the Autoware pose-estimator contract topic).

  Included, unnamespaced, as a sibling group from the forked
  tier4_localization_launch/launch/pose_twist_estimator/pose_twist_estimator.launch.xml
  (Task 8) - the Isaac-style bypass documented in
  docs/design/localization-method-switching.md Sec 4: the pose reaches the
  contract topic from outside rather than through push-ros-namespace
  pose_estimator.

  /pf-namespace decision (Task 7 wrinkle 2): particle_filter's topic names
  (/pf/pose/odom, /pf/viz/inferred_pose) and its nav2_map_server client
  (/map_server/map) are hard-coded absolute strings in the vendored fork
  (particle_filter.py), so a <push-ros-namespace> here would not relocate
  them - only this launch file's own nodes (pointcloud_to_laserscan,
  scan_qos_bridge, wheel_imu_odom, mcl_pose_relay) would move, splitting the
  graph. Decision: accept the global /pf/... and /map_server/map names and
  do NOT push a namespace, matching the Isaac bypass precedent (which is
  also unnamespaced) and the fact that pose_source is a single active
  selection - there is never more than one pose estimator's /pf/* graph
  alive at once in this system.
-->
<launch>
  <!-- Sensor/vehicle input topics (sample_sensor_kit defaults, matching the
       Phase 4 gate reproduce block in docs/reports/2dlidar-phase4-init-gating.md) -->
  <arg name="velocity_topic" default="/vehicle/status/velocity_status"/>
  <arg name="imu_topic" default="/sensing/imu/tamagawa/imu_raw"/>
  <arg name="imu_yaw_sign" default="-1.0"
       description="sample_sensor_kit Tamagawa IMU z-rate sign fix ; see wheel_imu_odom.py"/>

  <!--
    Scan input contract. MCL takes ONE sensor_msgs/LaserScan in any frame TF
    connects to base_link; mcl_scan_normalizer re-expresses it about base_link,
    because particle_filter treats the scan as originating at the particle pose.

    The sensor kit owns scan production: a real 2-D LiDAR publishes a LaserScan
    directly, and a 3-D LiDAR gets one ring extracted in the kit, where the
    choice of ring belongs ; it depends on the vehicle height and the mounting.
    MCL therefore holds NO scan geometry of its own; the z band that used to live
    here was the sample kit's sensor height and selected an empty slab on the
    AutoSDV vehicle (kit z 0.0 against sample 2.0), silently.

    scan_source:
      external        the kit publishes scan_topic (default; production)
      test_pointcloud additionally slice a slab out of a 3-D cloud, for the
                      Autoware sample bags whose kit publishes no scan
    See docs/design/mcl-user-setup-ux.md.
  -->
  <arg name="scan_topic" default="/scan_raw"
       description="LaserScan from the sensor kit; normalised onto /scan"/>
  <arg name="scan_source" default="external"
       description="external | test_pointcloud"/>
  <arg name="test_input_pointcloud" default="/sensing/lidar/top/pointcloud_raw_ex"
       description="scan_source:=test_pointcloud only"/>

  <!-- particle_filter / pointcloud_to_laserscan parameter files (Phase 4 gate
       defaults). Two files, not one, because both use "/**" wildcard node-name
       matching (required so params still apply once these nodes run inside the
       /localization namespace under the full stack - see the files'
       headers), and a single YAML cannot repeat a top-level "/**" key.
       Override either with a sibling copy for a different sensor kit / map
       resolution. -->
  <arg name="mcl_particle_filter_param_file" default="$(find-pkg-share autosdv_mcl_launch)/config/mcl_particle_filter.param.yaml"/>
  <arg name="require_initialpose" default="true"
       description="gate MCL updates/publication until a real /initialpose seed arrives (Phase 4 Task 2)"/>
  <!-- RNG seed for particle placement and resampling. -1 (the param file's
       default) leaves the filter nondeterministic, which is right for
       operation but useless for measurement: a run labelled "seed N" whose
       seed was never applied is not reproducible and its spread across runs
       is not seed spread. Exposed here, and plumbed up to the top-level
       launch, so an accuracy matrix can set it per run; see
       scripts/2dlidar/run-mcl-e2e-matrix.sh. -->
  <arg name="mcl_random_seed" default="-1"
       description="particle_filter RNG seed; -1 = nondeterministic (operational default)"/>

  <!-- mcl_pose_relay output: the Autoware pose-estimator contract topic. -->
  <arg name="output_pose_with_covariance_topic"
       default="/localization/pose_estimator/pose_with_covariance"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="map_frame" default="map"/>
  <!-- pointcloud_to_laserscan's target_frame:=base_link (below) means /scan is
       already expressed in base_link, so the relay's sensor->base composition
       is a free identity transform (no static laser->base_link TF needed). -->

  <!-- Task 8 end-to-end diagnosis (2026-07-27): mcl_pose_relay's (T6) stamp
       recovery does a SECOND lookup, map_frame -> sensor_frame, meant to
       read back particle_filter's own scan-accurate broadcast stamp. With
       sensor_frame="base_link" that lookup is "map -> base_link" - which is
       NOT particle_filter's broadcast (its hardcoded child frame is
       '/laser'; see particle_filter.py's publish_tf). Replaying the sample
       bag (itself originally recorded from a REAL NDT+EKF run) puts a
       genuine, unrelated "map -> base_link" chain onto the TF graph, so the
       lookup silently resolved against THAT instead of failing over -
       publishing a frozen/wrong stamp that wrecked ekf_localizer's delay
       compensation. Confirmed via a three-way GT comparison on one seed:
       GT vs /pf/viz/inferred_pose (raw filter) trans. mean 4.23 m; GT vs
       this relay's own output 92.28 m, same underlying estimate - an
       84x amplification entirely attributable to the corrupted stamp
       ruining nearest-timestamp pairing (and, in the live EKF, its delay
       compensation). An attempted fix pointing sensor_frame at "laser"
       instead (so the lookup would target particle_filter's ACTUAL
       broadcast) surfaced a second, independent defect: the sample bag's
       own /tf_static carries a genuinely bogus 2020-04-03 timestamp (a
       real-vehicle clock-not-yet-synced artifact baked into the recording),
       which tf2 treats as an unrelated frame's earliest-available data and
       then refuses the SAME lookup outright ("extrapolation into the
       past"), dropping every message - worse than the original bug. Given
       both TF-based paths are unreliable against this specific replayed
       bag, stamp_source:=header below bypasses the TF lookup entirely and
       uses the input message's own header.stamp, which get_clock().now()
       already correctly resolves in sim time under use_sim_time - see
       mcl_pose_relay.py's stamp_source parameter (added for this fix; 'tf'
       remains the default there, preserving every other caller's existing
       behavior byte for byte). -->
  <arg name="stamp_source" default="header"/>

  <arg name="use_sim_time" default="true"/>
  <!-- Namespace particle_filter's <executable> command must manually apply
       (see the node's comment below for why it is an <executable>, not a
       <node>, and therefore does not auto-inherit the ambient
       push-ros-namespace like this file's other nodes do). This file is
       only ever included from the forked pose_twist_estimator.launch.xml,
       itself included from within tier4_localization_launch's
       push-ros-namespace="localization" - confirmed empirically (Task 8)
       via the equivalent <node>'s resolved name, /localization/particle_filter.
       Override if this file is ever included somewhere else. -->
  <arg name="particle_filter_ns" default="/localization"/>

  <!-- Optional test adapter: synthesise a scan from a 3-D cloud. Off by
       default; see the scan_source arg above and the adapter's own header. -->
  <group if="$(eval &quot;'$(var scan_source)' == 'test_pointcloud'&quot;)">
    <include file="$(find-pkg-share autosdv_mcl_launch)/launch/scan_source_test_pointcloud.launch.xml">
      <arg name="input_pointcloud" value="$(var test_input_pointcloud)"/>
      <arg name="output_scan" value="$(var scan_topic)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>
  </group>

  <!-- - mcl_scan_normalizer: the kit's scan -> /scan about base_link.
       Absorbs QoS (SensorDataQoS in, RELIABLE out, replacing scan_qos_bridge),
       the mounting offset, and the scan-side diagnostics. -->
  <node pkg="autosdv_mcl_launch" exec="mcl_scan_normalizer" name="mcl_scan_normalizer">
    <param name="input_topic" value="$(var scan_topic)"/>
    <param name="output_topic" value="/scan"/>
    <param name="base_frame" value="$(var base_frame)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- - wheel_imu_odom: VelocityReport + Imu -> /odom (unicycle model). -->
  <node pkg="autosdv_mcl_launch" exec="mcl_wheel_imu_odom" name="wheel_imu_odom">
    <param name="velocity_topic" value="$(var velocity_topic)"/>
    <param name="imu_topic" value="$(var imu_topic)"/>
    <param name="odom_topic" value="/odom"/>
    <param name="imu_yaw_sign" value="$(var imu_yaw_sign)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- - particle_filter (vendored fork, NEWSLabNTU/particle_filter@autosdv).
       Blocks on the nav_msgs/GetMap service at /map_server/map in __init__,
       but only waits for the SERVICE to exist, not for nav2_map_server to
       reach ACTIVE - calling GetMap before activation returns an EMPTY
       grid (resolution 0.0), which crashes particle_filter with a
       ZeroDivisionError (confirmed during Task 8 end-to-end verification:
       the map component (Task 1) and this file are launch-tree siblings
       with no ordering guarantee, so this race is not rare).

       wait_for_active_map.sh polls for a real (nonzero-resolution) map
       before starting the real process. This MUST be a <node>'s
       launch-prefix in principle, but play_launch's Rust parser (this
       repo's preferred launch runner per CLAUDE.md) silently drops
       launch-prefix - confirmed empirically: the resolved process cmdline
       had no wrapper in front of it, and the ZeroDivisionError still
       occurred. Using <executable> instead (the same tool play_launch
       already handles correctly for autosdv_map_component's own lifecycle
       bringup script) sidesteps the gap; the cost is that <executable>
       does not auto-apply the ambient push-ros-namespace the way <node>
       does, so this command applies it manually via -r __ns - see the
       particle_filter_ns arg above. Absolute /pf/... topic names - see
       this file's header for the namespacing decision. -->
  <executable
    cmd="$(find-pkg-share autosdv_mcl_launch)/scripts/wait_for_active_map.sh
         ros2 run particle_filter particle_filter --ros-args
         -r __ns:=$(var particle_filter_ns) -r __node:=particle_filter
         --params-file $(var mcl_particle_filter_param_file)
         -p require_initialpose:=$(var require_initialpose)
         -p random_seed:=$(var mcl_random_seed)
         -p use_sim_time:=$(var use_sim_time)"
    name="particle_filter"
    output="screen"
  />

  <!-- - mcl_pose_relay: /pf/pose/odom -> the contract topic, fixing
       particle_filter's covariance-layout/stamp/frame-id/base-link defects
       (Task 6). -->
  <node pkg="autosdv_mcl_launch" exec="mcl_pose_relay" name="mcl_pose_relay">
    <param name="input_topic" value="/pf/pose/odom"/>
    <param name="input_type" value="odometry"/>
    <param name="output_topic" value="$(var output_pose_with_covariance_topic)"/>
    <param name="base_frame" value="$(var base_frame)"/>
    <param name="map_frame" value="$(var map_frame)"/>
    <!-- base_link by construction: the normaliser publishes /scan about
         base_link, so the relay's sensor->base composition is an identity. -->
    <param name="sensor_frame" value="$(var base_frame)"/>
    <param name="stamp_source" value="$(var stamp_source)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
