<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autosdv_isaac_slam_launch</name>
  <version>0.1.0</version>
  <description>Launch configuration for Isaac ROS Visual SLAM with ZED camera integration in AutoSDV</description>

  <maintainer email="autosdv@newslab.ntu.edu.tw">AutoSDV Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Isaac ROS dependencies -->
  <exec_depend>isaac_ros_visual_slam</exec_depend>
  <exec_depend>isaac_ros_image_proc</exec_depend>

  <!-- ZED camera -->
  <exec_depend>zed_wrapper</exec_depend>

  <!-- Bridge node -->
  <exec_depend>odometry_pose_bridge</exec_depend>

  <!-- Topic tools for relaying -->
  <exec_depend>topic_tools</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
