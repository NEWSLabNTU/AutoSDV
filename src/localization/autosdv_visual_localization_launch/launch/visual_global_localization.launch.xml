<?xml version="1.0" encoding="UTF-8"?>
<!--
  Visual Global Localization (cuVGL) Launch File

  Launches the NVIDIA Isaac ROS Visual Global Localization node for
  determining initial pose from a pre-built visual map.

  Inputs:
    - Stereo camera images (mono8)
    - Camera info
    - Visual map directory

  Outputs:
    - /visual_localization/pose (PoseWithCovarianceStamped)
-->
<launch>
  <!-- Arguments -->
  <arg name="map_dir" description="Path to cuVGL visual map directory"/>
  <arg name="config_dir" default="" description="Path to cuVGL config (optional, uses map_dir if empty)"/>
  <arg name="camera_namespace" default="/sensing/camera/zedxm" description="ZED camera namespace"/>
  <arg name="camera_model" default="zedxm" description="Camera model for frame names"/>

  <!-- Derived values -->
  <!-- Use map_dir as config_dir if config_dir is empty -->
  <let name="config_dir_resolved" value="$(var map_dir)" if="$(eval &quot;'$(var config_dir)' == ''&quot;)"/>
  <let name="config_dir_resolved" value="$(var config_dir)" unless="$(eval &quot;'$(var config_dir)' == ''&quot;)"/>
  <let name="left_optical_frame" value="$(var camera_model)_left_camera_optical_frame"/>
  <let name="right_optical_frame" value="$(var camera_model)_right_camera_optical_frame"/>

  <!-- Composable Node Container for cuVGL image processing -->
  <node_container pkg="rclcpp_components" exec="component_container_mt" name="visual_localization_container" namespace="visual_localization">
    <!-- Image Format Converter: Left Camera (RGB8 -> Mono8) -->
    <composable_node pkg="isaac_ros_image_proc" plugin="nvidia::isaac_ros::image_proc::ImageFormatConverterNode" name="vgl_left_image_converter">
      <param name="encoding_desired" value="mono8"/>
      <remap from="image_raw" to="$(var camera_namespace)/left/color/rect/image"/>
      <remap from="image" to="/visual_localization/image_0"/>
    </composable_node>

    <!-- Image Format Converter: Right Camera (RGB8 -> Mono8) -->
    <composable_node pkg="isaac_ros_image_proc" plugin="nvidia::isaac_ros::image_proc::ImageFormatConverterNode" name="vgl_right_image_converter">
      <param name="encoding_desired" value="mono8"/>
      <remap from="image_raw" to="$(var camera_namespace)/right/color/rect/image"/>
      <remap from="image" to="/visual_localization/image_1"/>
    </composable_node>
  </node_container>

  <!-- Camera Info Relays -->
  <node pkg="topic_tools" exec="relay" name="vgl_left_camera_info_relay" namespace="visual_localization"
        args="$(var camera_namespace)/left/color/rect/camera_info /visual_localization/camera_info_0"/>

  <node pkg="topic_tools" exec="relay" name="vgl_right_camera_info_relay" namespace="visual_localization"
        args="$(var camera_namespace)/right/color/rect/camera_info /visual_localization/camera_info_1"/>

  <!-- Visual Global Localization Node (cuVGL) -->
  <node pkg="isaac_ros_visual_global_localization"
        exec="isaac_ros_visual_global_localization"
        name="visual_global_localization_node"
        namespace="visual_localization"
        output="screen">
    <!-- Load default parameters -->
    <param from="$(find-pkg-share autosdv_visual_localization_launch)/config/visual_global_localization_params.yaml"/>

    <!-- Map and config paths -->
    <param name="map_dir" value="$(var map_dir)"/>
    <param name="config_dir" value="$(var config_dir_resolved)"/>

    <!-- Camera optical frames -->
    <param name="camera_optical_frames" value="['$(var left_optical_frame)', '$(var right_optical_frame)']"/>
  </node>
</launch>
