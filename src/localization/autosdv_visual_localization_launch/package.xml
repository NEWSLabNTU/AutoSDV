<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autosdv_visual_localization_launch</name>
  <version>0.1.0</version>
  <description>Launch files for camera-only visual localization using NVIDIA Isaac ROS (cuVGL + cuVSLAM)</description>
  <maintainer email="autosdv@example.com">AutoSDV Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>isaac_ros_visual_slam</exec_depend>
  <exec_depend>isaac_ros_visual_global_localization</exec_depend>
  <exec_depend>autosdv_isaac_slam_launch</exec_depend>
  <exec_depend>visual_pose_initializer_bridge</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
