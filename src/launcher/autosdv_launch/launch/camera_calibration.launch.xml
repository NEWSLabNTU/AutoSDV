<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Camera Calibration Launch File for AutoSDV -->
  
  <!-- Launch ZED camera with zedxm model -->
  <include file="$(find-pkg-share zed_wrapper)/launch/zed_camera.launch.py">
    <arg name="camera_model" value="zedxm"/>
  </include>
  
  <!-- Launch USB camera using gscam -->
  <!-- <include file="$(find-pkg-share zed_wrapper)/launch/zed_camera.launch.py"> -->
  <!--   <arg name="camera_model" value="zedxm"/> -->
  <!-- </include> -->
  
  <!-- Launch intrinsic camera calibrator -->
  <include file="$(find-pkg-share intrinsic_camera_calibrator)/launch/calibrator.launch.xml"/>
  
</launch>
