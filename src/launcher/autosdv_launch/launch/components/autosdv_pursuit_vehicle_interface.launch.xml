<?xml version="1.0" encoding="UTF-8"?>
<!--
  The AutoSDV vehicle interface for the coach-pursuit lab (Lab 2): a mirror of
  autosdv_vehicle_launch's vehicle_interface.launch.xml that also sets the
  actuator's speed-controller plug-in, which is how a student's SpeedPID (the
  inner loop) gets into the car.

  It is a mirror, not an include, because the submodule's file loads
  actuator.yaml with no way for a caller to add parameters, and a later
  param file is the only way to override a value actuator.yaml sets. When that
  file grows an extra-params argument, delete this one and pass the three
  speed_controller_* values through it instead. Until then, keep the node set
  and remaps here in step with it.

  coach_pursuit.launch.xml launches this with the stock vehicle interface
  switched off (launch_vehicle_interface:=false), so the actuator never runs
  twice.
-->
<launch>
  <arg name="is_simulation" default="false" description="dry run: no PWM output"/>
  <arg name="actuator_log_level" default="info"/>
  <arg name="vehicle_info_param_file" default="$(find-pkg-share autosdv_vehicle_description)/config/vehicle_info.param.yaml"/>
  <arg name="speed_controller_class"
       default="autosdv_vehicle_interface.speed_controller:AckermannSpeedPID"
       description="inner loop, package.module:ClassName with reset() and update(target, measured, dt) -> PWM"/>
  <arg name="speed_controller_params" default=""
       description="the plug-in's own parameters as a YAML mapping string, e.g. {kp: 20.0, ki: 4.0}"/>
  <!-- loop: dt is the actuator loop period, the interval update() is actually
       called at. velocity_report (the actuator's legacy default) hands it the
       time since the last 20 Hz report while calling it at 100 Hz, which
       triples a student's effective integral gain. -->
  <arg name="speed_controller_dt_source" default="loop"/>

  <group>
    <push-ros-namespace namespace="autosdv"/>

    <node pkg="autosdv_vehicle_interface" exec="actuator" name="actuator_node" output="screen"
          args="--ros-args --log-level $(var actuator_log_level)">
      <param from="$(find-pkg-share autosdv_vehicle_interface)/params/actuator.yaml"/>
      <param from="$(var vehicle_info_param_file)"/>
      <param name="dry_run" value="$(var is_simulation)"/>
      <param name="speed_controller_class" value="$(var speed_controller_class)"/>
      <param name="speed_controller_params" value="$(var speed_controller_params)" type="str"/>
      <param name="speed_controller_dt_source" value="$(var speed_controller_dt_source)"/>
      <remap from="~/input/control_cmd" to="/control/command/control_cmd"/>
      <remap from="~/input/velocity_status" to="/vehicle/status/velocity_status"/>
      <remap from="~/input/emergency" to="/control/command/emergency_cmd"/>
      <remap from="~/input/mrm_state" to="/system/fail_safe/mrm_state"/>
    </node>

    <node pkg="autosdv_vehicle_interface" exec="velocity_report" name="velocity_report_node" output="screen">
      <param from="$(find-pkg-share autosdv_vehicle_interface)/params/velocity_report.yaml"/>
      <remap from="~/output/velocity_status" to="/vehicle/status/velocity_status"/>
    </node>

    <node pkg="autosdv_vehicle_interface" exec="gear_manager" name="gear_manager_node" output="screen">
      <param from="$(find-pkg-share autosdv_vehicle_interface)/params/actuator.yaml"/>
      <param from="$(find-pkg-share autosdv_vehicle_interface)/params/gear_manager.yaml"/>
    </node>

    <node pkg="autosdv_vehicle_interface" exec="control_mode_manager" name="control_mode_manager_node" output="screen">
      <param from="$(find-pkg-share autosdv_vehicle_interface)/params/control_mode_manager.yaml"/>
    </node>

    <node pkg="autosdv_vehicle_interface" exec="steering_status" name="steering_status_node" output="screen">
      <param from="$(var vehicle_info_param_file)"/>
      <param from="$(find-pkg-share autosdv_vehicle_interface)/params/steering_status.yaml"/>
    </node>

    <node pkg="autosdv_vehicle_interface" exec="signal_manager" name="signal_manager_node" output="screen">
      <param from="$(find-pkg-share autosdv_vehicle_interface)/params/signal_manager.yaml"/>
    </node>
  </group>
</launch>
