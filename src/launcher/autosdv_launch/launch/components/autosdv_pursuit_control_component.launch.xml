<?xml version="1.0"?>
<!--
  Autoware control for the coach-pursuit lab (Lab 2), shared by the vehicle
  launch (coach_pursuit.launch.xml) and the simulator launch
  (coach_pursuit_sim.launch.xml).

  The stock tier4_control_component, with four lab choices it cannot express
  through its own arguments, which is why this includes tier4_control_launch's
  control.launch.xml directly instead:

    lateral_controller_mode    pure_pursuit. No steering feedback on AutoSDV,
                               and MPC is the controller that aborted on a
                               degenerate path in the prototype.
    launch_lane_departure_checker / launch_autonomous_emergency_braking /
    launch_collision_detector / launch_control_evaluator
                               false. All four need a lanelet map or
                               perception output, and the lab runs neither.
                               The safety they would add is carried by the
                               planner's standoff floor and the MRM backstop.
    shift_decider_param_path   park_on_goal: false, so the route-less stack
                               never commands PARK.
    output_gear_cmd            where vehicle_cmd_gate's gear goes. The
                               simulator launch moves it off
                               /control/command/gear_cmd so drive_gear_hold can
                               own that topic without two publishers on it.

  Everything else is tier4_control_component's wiring, byte for byte. Re-fork
  from the installed file when the Autoware version changes.
-->
<launch>
  <arg name="vehicle_model" default="autosdv_vehicle"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="check_external_emergency_heartbeat" default="false"/>
  <arg name="lateral_controller_mode" default="pure_pursuit"/>
  <arg name="longitudinal_controller_mode" default="pid"/>
  <arg name="shift_decider_param_path"
       default="$(find-pkg-share autosdv_launch)/config/control/pursuit/shift_decider.param.yaml"/>
  <arg name="output_gear_cmd" default="/control/command/gear_cmd"/>

  <let name="cfg" value="$(find-pkg-share autoware_launch)/config/control"/>

  <group scoped="false">
    <include file="$(find-pkg-share autoware_global_parameter_loader)/launch/global_params.launch.py">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <include file="$(find-pkg-share tier4_control_launch)/launch/control.launch.xml">
    <arg name="vehicle_param_file" value="$(find-pkg-share $(var vehicle_model)_description)/config/vehicle_info.param.yaml"/>
    <arg name="vehicle_id" value="$(var vehicle_id)"/>

    <!-- the lab choices -->
    <arg name="lateral_controller_mode" value="$(var lateral_controller_mode)"/>
    <arg name="longitudinal_controller_mode" value="$(var longitudinal_controller_mode)"/>
    <arg name="launch_lane_departure_checker" value="false"/>
    <arg name="launch_autonomous_emergency_braking" value="false"/>
    <arg name="launch_collision_detector" value="false"/>
    <arg name="launch_obstacle_collision_checker" value="false"/>
    <arg name="launch_predicted_path_checker" value="false"/>
    <arg name="launch_control_evaluator" value="false"/>
    <arg name="shift_decider_param_path" value="$(var shift_decider_param_path)"/>
    <arg name="output_gear_cmd" value="$(var output_gear_cmd)"/>

    <!-- stock wiring (tier4_control_component.launch.xml) -->
    <arg name="trajectory_follower_mode" value="trajectory_follower_node"/>
    <arg name="launch_external_cmd_selector" value="true"/>
    <arg name="launch_external_cmd_converter" value="true"/>
    <arg name="launch_control_validator" value="true"/>
    <arg name="use_aeb_autoware_state_check" value="true"/>
    <arg name="check_external_emergency_heartbeat" value="$(var check_external_emergency_heartbeat)"/>
    <arg name="input_objects_topic_name" value="/perception/object_recognition/objects"/>
    <arg name="input_pointcloud_topic_name" value="/perception/obstacle_segmentation/pointcloud"/>
    <arg name="trajectory_follower_node_param_path" value="$(var cfg)/trajectory_follower/trajectory_follower_node.param.yaml"/>
    <arg name="lat_controller_param_path" value="$(var cfg)/trajectory_follower/lateral/$(var lateral_controller_mode).param.yaml"/>
    <arg name="lon_controller_param_path" value="$(var cfg)/trajectory_follower/longitudinal/$(var longitudinal_controller_mode).param.yaml"/>
    <arg name="nearest_search_param_path" value="$(var cfg)/common/nearest_search.param.yaml"/>
    <arg name="vehicle_cmd_gate_param_path" value="$(var cfg)/vehicle_cmd_gate/vehicle_cmd_gate.param.yaml"/>
    <arg name="control_command_gate_param_path" value="$(var cfg)/control_command_gate/control_command_gate.param.yaml"/>
    <arg name="lane_departure_checker_param_path" value="$(var cfg)/lane_departure_checker/lane_departure_checker.param.yaml"/>
    <arg name="control_validator_param_path" value="$(var cfg)/control_validator/control_validator.param.yaml"/>
    <arg name="operation_mode_transition_manager_param_path" value="$(var cfg)/operation_mode_transition_manager/operation_mode_transition_manager.param.yaml"/>
    <arg name="obstacle_collision_checker_param_path" value="$(var cfg)/obstacle_collision_checker/obstacle_collision_checker.param.yaml"/>
    <arg name="external_cmd_selector_param_path" value="$(var cfg)/external_cmd_selector/external_cmd_selector.param.yaml"/>
    <arg name="aeb_param_path" value="$(var cfg)/autoware_autonomous_emergency_braking/autonomous_emergency_braking.param.yaml"/>
    <arg name="collision_detector_param_path" value="$(var cfg)/autoware_collision_detector/collision_detector.param.yaml"/>
    <arg name="predicted_path_checker_param_path" value="$(var cfg)/predicted_path_checker/predicted_path_checker.param.yaml"/>
  </include>
</launch>
