#!/bin/bash
# AutoSDV environment configuration for direnv

if [ -f /opt/autoware/autoware-env ]; then
    # Source Autoware environment if available
    source /opt/autoware/autoware-env
else
    # Fallback: Manual Autoware and ROS 2 setup
    echo "=========================================="
    echo "INFO: /opt/autoware/autoware-env not found"
    echo "INFO: Please source your Autoware installation manually:"
    echo "      source \$AUTOWARE_DIR/install/setup.bash"
    echo "=========================================="

    export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

    # Unset ROS_LOCALHOST_ONLY if present
    if [[ -v ROS_LOCALHOST_ONLY ]]; then
        echo 'WARNING: ROS_LOCALHOST_ONLY variable is present. Unsetting it.'
        unset ROS_LOCALHOST_ONLY
    fi

    # Check network parameters
    if (ip link show lo | grep -q "MULTICAST") 2>/dev/null; then
        multicast_ok=true
    else
        multicast_ok=false
    fi

    if [ \
         "$(sysctl -n net.core.rmem_max 2>/dev/null)" = 2147483647 \
         -a \
         "$(sysctl -n net.ipv4.ipfrag_time 2>/dev/null)" = 3 \
         -a \
         "$(sysctl -n net.ipv4.ipfrag_high_thresh 2>/dev/null)" = 134217728 \
      ]
    then
        sysctl_ok=true
    else
        sysctl_ok=false
    fi

    # Apply CycloneDDS config if network is properly configured
    if $multicast_ok && $sysctl_ok; then
        export CYCLONEDDS_URI="file://$(pwd)/cyclonedds.xml"
    else
        echo "=========================================="
        echo "WARNING: System network settings are not configured properly."
        echo "WARNING: CycloneDDS configuration is not applied."
        echo ""
        if ! $multicast_ok; then
            echo "ERROR: Multicast is not enabled on loopback interface."
            echo "       This should not normally happen. Check your network configuration."
        fi
        if ! $sysctl_ok; then
            echo "ERROR: Required sysctl parameters are not set correctly."
            echo ""
            echo "Current values:"
            echo "  net.core.rmem_max          = $(sysctl -n net.core.rmem_max 2>/dev/null || echo 'not set')"
            echo "  net.ipv4.ipfrag_time       = $(sysctl -n net.ipv4.ipfrag_time 2>/dev/null || echo 'not set')"
            echo "  net.ipv4.ipfrag_high_thresh = $(sysctl -n net.ipv4.ipfrag_high_thresh 2>/dev/null || echo 'not set')"
            echo ""
            echo "Required values:"
            echo "  net.core.rmem_max          = 2147483647"
            echo "  net.ipv4.ipfrag_time       = 3"
            echo "  net.ipv4.ipfrag_high_thresh = 134217728"
            echo ""
            echo "To fix, run these commands as root:"
            echo "  sudo sysctl -w net.core.rmem_max=2147483647"
            echo "  sudo sysctl -w net.ipv4.ipfrag_time=3"
            echo "  sudo sysctl -w net.ipv4.ipfrag_high_thresh=134217728"
            echo ""
            echo "To make permanent, add to /etc/sysctl.conf or /etc/sysctl.d/99-autoware.conf:"
            echo "  net.core.rmem_max=2147483647"
            echo "  net.ipv4.ipfrag_time=3"
            echo "  net.ipv4.ipfrag_high_thresh=134217728"
            echo ""
            echo "Then run: sudo sysctl -p"
        fi
        echo "=========================================="
    fi

    # Source ROS 2 Humble
    source /opt/ros/humble/setup.bash
fi

# Source workspace if it has been built
if [ -f install/setup.bash ]; then
    source install/setup.bash
fi
