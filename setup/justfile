# AutoSDV Development Environment Setup
# Usage: just setup          - Run full setup
#        just resume         - Resume from last failure
#        just <step>         - Run specific step
#        just clean-markers  - Reset all checkpoints

set shell := ["bash", "-uc"]
set positional-arguments

# Directories
root_dir := justfile_directory()
marker_dir := root_dir / ".markers"
scripts_dir := root_dir / "scripts"
files_dir := root_dir / "files"
data_dir := root_dir / ".." / "data"
repo_scripts_dir := root_dir / ".." / "scripts"

# Architecture detection
arch := `uname -m`

# Export for child scripts
export DATA_DIR := data_dir
export ARCH := arch

# Colors for output
green := '\033[0;32m'
yellow := '\033[0;33m'
red := '\033[0;31m'
nc := '\033[0m'

# Default recipe - show help
default:
    @just --list

# Ordering that matters:
#   - opencv runs AFTER autoware-debian and isaac-ros, because both pull
#     packages that depend on libopencv-dev; letting apt settle first leaves
#     one state to correct rather than racing it.
#   - autoware-data runs AFTER autoware-debian, because it mirrors whatever
#     /opt/autoware/*/data that package installed.
#   - rust runs before colcon-cargo-ros2 and python-deps, because both want
#     cargo on PATH.
#
# just shows only the LAST contiguous comment block in `just --list`, so the
# blank line below is what keeps the description a description.

# Full setup (runs all steps in order)
setup: _init ros2 ros2-dev-tools rust _setup-colcon-cargo-ros2 _setup-play-launch gdown geographiclib pacmod dev-tools _setup-blickfeld _setup-autoware-debian _setup-autoware-data _setup-tensorrt-engines _setup-isaac-ros _setup-opencv python-deps ublox-udev _setup-zed-sdk _setup-cyclonedds-sysctl _setup-multicast-lo _setup-turbovnc-virtualgl ros-deps
    @printf "{{green}}✓ Setup complete!{{nc}}\n"

# Conditional Autoware Debian install (based on SKIP_AUTOWARE_DEBIAN env var)
_setup-autoware-debian:
    #!/usr/bin/env bash
    if [[ "${SKIP_AUTOWARE_DEBIAN:-0}" == "1" ]]; then
        printf "{{yellow}}⊘{{nc}} autoware-debian skipped (user choice)\n"
    else
        just autoware-debian
    fi

# Writable Autoware data dir (based on SETUP_AUTOWARE_DATA env var).
#
# Must run AFTER autoware-debian: it mirrors whatever /opt/autoware/*/data the
# package installed. Cheap (symlinks, under a second) and it is what lets
# TensorRT cache its engines at all — the packaged directory is root-owned, so
# without this every model fails to write its .engine and rebuilds, and fails,
# on every launch.
_setup-autoware-data:
    #!/usr/bin/env bash
    if [[ "${SETUP_AUTOWARE_DATA:-n}" != "y" ]]; then
        printf "{{yellow}}⊘{{nc}} autoware-data skipped (user choice)\n"
    elif [[ ! -d /opt/autoware ]]; then
        printf "{{yellow}}⊘{{nc}} autoware-data skipped (no /opt/autoware — install Autoware first)\n"
    else
        "{{repo_scripts_dir}}/setup_autoware_data.sh"
    fi

# Pre-compile TensorRT engines (based on BUILD_TENSORRT_ENGINES env var).
#
# Minutes per model on an Orin. Skipping is legitimate — the first launch will
# build them instead — but it does so INSIDE each node's constructor, so
# perception is unavailable until it finishes.
_setup-tensorrt-engines:
    #!/usr/bin/env bash
    if [[ "${BUILD_TENSORRT_ENGINES:-n}" != "y" ]]; then
        printf "{{yellow}}⊘{{nc}} tensorrt-engines skipped (built on first launch instead)\n"
    elif [[ ! -d /opt/autoware ]]; then
        printf "{{yellow}}⊘{{nc}} tensorrt-engines skipped (no /opt/autoware)\n"
    else
        printf "{{green}}→{{nc}} Compiling TensorRT engines (minutes)...\n"
        ( cd "{{root_dir}}/.." && just build-engines )
    fi

# Build the writable Autoware model tree at data/autoware_data
autoware-data:
    @"{{repo_scripts_dir}}/setup_autoware_data.sh"

# Conditional Blickfeld install (based on SKIP_BLICKFELD env var)
_setup-blickfeld:
    #!/usr/bin/env bash
    if [[ "${SKIP_BLICKFELD:-0}" == "1" ]]; then
        printf "{{yellow}}⊘{{nc}} blickfeld skipped (user choice)\n"
    else
        just blickfeld
    fi

# Conditional ZED SDK install (based on INSTALL_ZED_SDK env var)
_setup-zed-sdk:
    #!/usr/bin/env bash
    if [[ "${INSTALL_ZED_SDK:-n}" == "y" ]]; then
        just install-zed-sdk
    else
        printf "{{yellow}}⊘{{nc}} zed-sdk skipped (user choice)\n"
        printf "{{yellow}}Note:{{nc}} Run 'just install-zed-sdk' to install later\n"
    fi

# Conditional CycloneDDS sysctl configuration (based on CONFIGURE_CYCLONEDDS_SYSCTL env var)
_setup-cyclonedds-sysctl:
    #!/usr/bin/env bash
    if [[ "${CONFIGURE_CYCLONEDDS_SYSCTL:-n}" == "y" ]]; then
        just cyclonedds-sysctl
    else
        printf "{{yellow}}⊘{{nc}} cyclonedds-sysctl skipped (user choice)\n"
        printf "{{yellow}}Note:{{nc}} Run 'just cyclonedds-sysctl' to configure later\n"
    fi

_setup-multicast-lo:
    #!/usr/bin/env bash
    if [[ "${CONFIGURE_MULTICAST_LO:-n}" == "y" ]]; then
        just multicast-lo
    else
        printf "{{yellow}}⊘{{nc}} multicast-lo skipped (user choice)\n"
        printf "{{yellow}}Note:{{nc}} Without it, lo loses multicast on reboot and ROS cannot start\n"
    fi

# Conditional Isaac ROS install (based on INSTALL_ISAAC_ROS env var)
_setup-isaac-ros:
    #!/usr/bin/env bash
    if [[ "${INSTALL_ISAAC_ROS:-n}" == "y" ]]; then
        just isaac-ros
    else
        printf "{{yellow}}⊘{{nc}} isaac-ros skipped (user choice)\n"
    fi

# Conditional TurboVNC + VirtualGL install (based on INSTALL_TURBOVNC_VIRTUALGL env var)
_setup-turbovnc-virtualgl:
    #!/usr/bin/env bash
    if [[ "${INSTALL_TURBOVNC_VIRTUALGL:-n}" == "y" ]]; then
        just turbovnc-virtualgl
    else
        printf "{{yellow}}⊘{{nc}} turbovnc-virtualgl skipped (user choice)\n"
    fi

# Conditional OpenCV consistency fix (based on INSTALL_OPENCV env var)
#
# Runs AFTER autoware-debian and isaac-ros on purpose: both pull packages that
# depend on libopencv-dev, so letting apt settle first means this has one state
# to correct rather than racing it.
_setup-opencv:
    #!/usr/bin/env bash
    if [[ "${INSTALL_OPENCV:-n}" == "y" ]]; then
        just opencv
    else
        printf "{{yellow}}⊘{{nc}} opencv skipped (user choice)\n"
        printf "{{yellow}}Note:{{nc}} Run 'just opencv' to fix later, or 'just opencv-check' to see the state\n"
    fi

# JetPack ships NVIDIA's OpenCV 4.8.0 as libopencv-dev, which owns
# /usr/include/opencv4, while every runtime library and every ROS deb on the
# system is Ubuntu's 4.5.4. Local builds then compile against one and link the
# other. It also costs the contrib modules, which is why aruco is missing.
#
# just takes only the LAST contiguous comment block as the description, so the
# blank line above is what keeps `just --list` readable.

# Put OpenCV on one version: Ubuntu 4.5.4, headers and runtime together
opencv: _init
    @just _run opencv "{{scripts_dir}}/install-opencv.sh"

# Report the OpenCV state without changing anything
opencv-check:
    @"{{scripts_dir}}/install-opencv.sh" --check

# Alias for setup (resume from where it left off due to markers)
resume: setup

# Install ZED SDK (optional, for ZED camera users)
install-zed-sdk: _init
    @just _run zed-sdk "{{scripts_dir}}/install-zed-sdk.sh"

# Install TurboVNC + VirtualGL (optional, for hardware-accelerated VNC)
turbovnc-virtualgl: _init
    @just _run turbovnc-virtualgl "{{scripts_dir}}/install-turbovnc-virtualgl.sh"

# Install NVIDIA Isaac ROS Visual Localization (cuVSLAM + cuVGL, requires NVIDIA GPU)
isaac-ros: _init ros2
    @just _run isaac-ros "{{scripts_dir}}/install-isaac-ros.sh"

# === Individual Setup Steps ===

# Install ROS 2 Humble
ros2: _init
    @just _run ros2 "{{scripts_dir}}/install-ros2.sh"

# Install ROS 2 development tools (colcon, rosdep, etc.)
ros2-dev-tools: _init ros2
    @just _run ros2-dev-tools "{{scripts_dir}}/install-ros2-dev-tools.sh"

# Conditional colcon-cargo-ros2 install (based on INSTALL_COLCON_CARGO_ROS2 env var)
#
# Defaults to ON: cuda_ndt_matcher builds with ament_cargo and colcon silently
# refuses to process it without this extension.
_setup-colcon-cargo-ros2:
    #!/usr/bin/env bash
    if [[ "${INSTALL_COLCON_CARGO_ROS2:-y}" == "y" ]]; then
        just colcon-cargo-ros2
    else
        printf "{{yellow}}⊘{{nc}} colcon-cargo-ros2 skipped (user choice)\n"
        printf "{{yellow}}Note:{{nc}} The Rust packages will not build; run 'just colcon-cargo-ros2' later\n"
    fi

# Install/upgrade colcon-cargo-ros2 (Rust support for colcon, >= 0.5.1)
colcon-cargo-ros2: _init
    @just _run colcon-cargo-ros2 "{{scripts_dir}}/install-colcon-cargo-ros2.sh"

# Conditional play_launch install (based on INSTALL_PLAY_LAUNCH env var)
#
# Defaults to ON: every `just launch` runs through play_launch, and 0.9.0 is
# the release with the startup governor. Deliberately markerless -- the script
# checks the installed version each run, so setup upgrades old machines.
_setup-play-launch:
    #!/usr/bin/env bash
    if [[ "${INSTALL_PLAY_LAUNCH:-y}" == "y" ]]; then
        just play-launch
    else
        printf "{{yellow}}⊘{{nc}} play-launch skipped (user choice)\n"
        printf "{{yellow}}Note:{{nc}} just launch cannot run without it; run 'just play-launch' later\n"
    fi

# Install/upgrade play_launch (launch orchestrator, >= 0.9.0)
play-launch: _init
    @"{{scripts_dir}}/install-play-launch.sh"

# Install gdown (Google Drive downloader)
gdown: _init
    @just _run gdown "pip3 install --user gdown"

# Install GeographicLib tools and data
geographiclib: _init
    #!/usr/bin/env bash
    [[ -f "{{marker_dir}}/geographiclib" ]] && printf "{{green}}✓{{nc}} geographiclib already done\n" && exit 0
    set -e
    printf "{{yellow}}→{{nc}} Installing geographiclib...\n"
    sudo apt-get update
    sudo apt-get install -y geographiclib-tools
    if [[ ! -f /usr/share/GeographicLib/geoids/egm2008-1.pgm ]]; then
        sudo geographiclib-get-geoids egm2008-1
    fi
    touch "{{marker_dir}}/geographiclib"
    printf "{{green}}✓{{nc}} geographiclib done\n"

# Add AutonomouStuff (pacmod) apt repository
pacmod: _init
    #!/usr/bin/env bash
    [[ -f "{{marker_dir}}/pacmod" ]] && printf "{{green}}✓{{nc}} pacmod already done\n" && exit 0
    set -e
    printf "{{yellow}}→{{nc}} Setting up pacmod repository...\n"
    sudo apt-get install -y apt-transport-https
    CODENAME=$(lsb_release -sc)
    echo "deb [trusted=yes] https://s3.amazonaws.com/autonomoustuff-repo/ ${CODENAME} main" | \
        sudo tee /etc/apt/sources.list.d/autonomoustuff-public.list > /dev/null
    sudo mkdir -p /etc/ros/rosdep/sources.list.d
    echo "yaml https://s3.amazonaws.com/autonomoustuff-repo/autonomoustuff-public-humble.yaml" | \
        sudo tee /etc/ros/rosdep/sources.list.d/40-autonomoustuff-public-humble.list > /dev/null
    sudo apt-get update
    touch "{{marker_dir}}/pacmod"
    printf "{{green}}✓{{nc}} pacmod done\n"

# Install development tools (git-lfs, pre-commit, Go, plotjuggler)
dev-tools: _init ros2
    #!/usr/bin/env bash
    [[ -f "{{marker_dir}}/dev-tools" ]] && printf "{{green}}✓{{nc}} dev-tools already done\n" && exit 0
    set -e
    printf "{{yellow}}→{{nc}} Installing dev tools...\n"
    sudo apt-get update
    sudo apt-get install -y git-lfs golang
    pip3 install --user pre-commit 'clang-format==17.0.5'
    # Check if plotjuggler is held before installing
    if ! apt-mark showhold | grep -q "ros-humble-plotjuggler-ros"; then
        sudo apt-get install -y ros-humble-plotjuggler-ros || true
    fi
    touch "{{marker_dir}}/dev-tools"
    printf "{{green}}✓{{nc}} dev-tools done\n"

# Install Blickfeld scanner library (with EULA acceptance)
blickfeld: _init
    @just _run blickfeld "{{scripts_dir}}/install-blickfeld.sh"

# Install Autoware Debian packages
autoware-debian: _init ros2
    @just _run autoware-debian "{{scripts_dir}}/install-autoware-debian.sh"

# Install Rust toolchain via rustup (needed for cuda_ndt_matcher and colcon-cargo-ros2)
rust: _init
    #!/usr/bin/env bash
    [[ -f "{{marker_dir}}/rust" ]] && printf "{{green}}✓{{nc}} rust already done\n" && exit 0
    set -e
    if command -v rustup &>/dev/null; then
        printf "{{green}}✓{{nc}} Rust already installed ($(rustc --version))\n"
    else
        printf "{{yellow}}→{{nc}} Installing Rust via rustup...\n"
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
        source "$HOME/.cargo/env"
        printf "{{green}}✓{{nc}} Rust installed ($(rustc --version))\n"
    fi
    touch "{{marker_dir}}/rust"

# colcon-cargo-ros2 and play_launch are NOT here: both need a version floor,
# and this step's marker would pin whatever version a machine first installed.
# They have their own markerless, version-checked recipes.

# Install AutoSDV Python dependencies (vehicle control deps)
python-deps: _init rust
    #!/usr/bin/env bash
    [[ -f "{{marker_dir}}/python-deps" ]] && printf "{{green}}✓{{nc}} python-deps already done\n" && exit 0
    set -e
    # Ensure cargo is on PATH (may have been installed by the rust recipe)
    [[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"
    printf "{{yellow}}→{{nc}} Installing Python dependencies...\n"
    pip3 install --user \
        Adafruit-PCA9685==1.0.1 \
        simple-pid==2.0.1
    touch "{{marker_dir}}/python-deps"
    printf "{{green}}✓{{nc}} python-deps done\n"

# Install u-blox GPS udev rules
ublox-udev: _init
    #!/usr/bin/env bash
    [[ -f "{{marker_dir}}/ublox-udev" ]] && printf "{{green}}✓{{nc}} ublox-udev already done\n" && exit 0
    set -e
    printf "{{yellow}}→{{nc}} Installing u-blox GPS udev rules...\n"
    sudo cp "{{files_dir}}/99-ublox-gps.rules" /etc/udev/rules.d/
    sudo chmod 644 /etc/udev/rules.d/99-ublox-gps.rules
    sudo udevadm control --reload-rules
    sudo udevadm trigger
    # Add user to dialout group
    sudo usermod -aG dialout "$USER" || true
    touch "{{marker_dir}}/ublox-udev"
    printf "{{green}}✓{{nc}} ublox-udev done\n"
    printf "{{yellow}}Note:{{nc}} Log out and back in for dialout group to take effect.\n"

# Both halves of the DDS network requirement. Either alone leaves a host that
# cannot create a DDS domain, so the umbrella recipe is what the menu and the
# warning in .envrc both point at.
# Configure the host network for CycloneDDS (kernel buffers + lo multicast)
network-dds: cyclonedds-sysctl multicast-lo

# Configure CycloneDDS kernel buffers (net.core.rmem_max + net.ipv4.ipfrag_*)
cyclonedds-sysctl: _init
    @just _run cyclonedds-sysctl "{{scripts_dir}}/configure-cyclonedds-sysctl.sh"

# Enable multicast on lo, persistently (systemd unit)
multicast-lo: _init
    @just _run multicast-lo "{{scripts_dir}}/configure-multicast-lo.sh"

# Install ROS dependencies for workspace packages
ros-deps: _init ros2-dev-tools
    #!/usr/bin/env bash
    [[ -f "{{marker_dir}}/ros-deps" ]] && printf "{{green}}✓{{nc}} ros-deps already done\n" && exit 0
    set -e
    printf "{{yellow}}→{{nc}} Installing ROS dependencies...\n"
    cd "{{root_dir}}/.."
    source /opt/ros/humble/setup.sh
    if [[ -f /opt/autoware/1.5.0/setup.sh ]]; then
        source /opt/autoware/1.5.0/setup.sh
    fi
    rosdep update --rosdistro=humble
    rosdep install -y --from-paths src --ignore-src -r
    touch "{{marker_dir}}/ros-deps"
    printf "{{green}}✓{{nc}} ros-deps done\n"

# === Utility Recipes ===

# Initialize marker directory
_init:
    @mkdir -p "{{marker_dir}}"

# Run a script with marker check
_run name cmd:
    #!/usr/bin/env bash
    if [[ -f "{{marker_dir}}/{{name}}" ]]; then
        printf "{{green}}✓{{nc}} {{name}} already done\n"
        exit 0
    fi
    printf "{{yellow}}→{{nc}} Running {{name}}...\n"
    set -e
    {{cmd}}
    touch "{{marker_dir}}/{{name}}"
    printf "{{green}}✓{{nc}} {{name}} done\n"

# Clean all markers (force re-run of all steps)
clean-markers:
    rm -rf "{{marker_dir}}"
    @printf "{{yellow}}→{{nc}} Markers cleared. Next 'just setup' will run all steps.\n"

# Clean specific marker
clean-marker name:
    rm -f "{{marker_dir}}/{{name}}"
    @printf "{{yellow}}→{{nc}} Marker '{{name}}' cleared.\n"

# Show setup status
status:
    #!/usr/bin/env bash
    echo "Setup Status:"
    echo "============="
    echo ""
    echo "Core Components:"
    for step in ros2 ros2-dev-tools colcon-cargo-ros2 gdown geographiclib pacmod dev-tools rust python-deps ublox-udev ros-deps; do
        if [[ -f "{{marker_dir}}/$step" ]]; then
            printf "  {{green}}✓{{nc}} %s\n" "$step"
        else
            printf "  {{red}}○{{nc}} %s\n" "$step"
        fi
    done
    echo ""
    echo "Optional Components:"
    for step in autoware-debian blickfeld; do
        if [[ -f "{{marker_dir}}/$step" ]]; then
            printf "  {{green}}✓{{nc}} %s\n" "$step"
        else
            printf "  {{yellow}}○{{nc}} %s (optional)\n" "$step"
        fi
    done
    # Isaac ROS Visual Localization
    if [[ -f "{{marker_dir}}/isaac-ros" ]]; then
        printf "  {{green}}✓{{nc}} isaac-ros (cuVSLAM + cuVGL)\n"
    else
        printf "  {{yellow}}○{{nc}} isaac-ros (cuVSLAM + cuVGL, run: ./setup.sh isaac-ros)\n"
    fi
    echo ""
    echo "Configuration:"
    # Report the observed state, not a marker: a marker says a step ran once,
    # while a reboot or a JetPack OTA can undo what it did.
    if sysctl -n net.core.rmem_max 2>/dev/null | awk '{exit !($1 >= 10485760)}'; then
        printf "  {{green}}✓{{nc}} cyclonedds-sysctl (rmem_max %s)\n" "$(sysctl -n net.core.rmem_max)"
    else
        printf "  {{red}}○{{nc}} cyclonedds-sysctl (rmem_max %s, need >= 10485760 — run: just cyclonedds-sysctl)\n" "$(sysctl -n net.core.rmem_max 2>/dev/null || echo unknown)"
    fi
    if ip link show lo 2>/dev/null | grep -q MULTICAST; then
        if systemctl is-enabled multicast-lo.service &>/dev/null; then
            printf "  {{green}}✓{{nc}} multicast-lo (enabled, survives reboot)\n"
        else
            printf "  {{yellow}}○{{nc}} multicast-lo (lo has MULTICAST now, but not after a reboot — run: just multicast-lo)\n"
        fi
    else
        printf "  {{red}}○{{nc}} multicast-lo (lo has no MULTICAST flag; ROS cannot start — run: just multicast-lo)\n"
    fi
    # play_launch: read the live version (the recipe is markerless).
    pl_ver=$(python3 -c "import importlib.metadata as m; print(m.version('play_launch'))" 2>/dev/null || true)
    if [[ -n "$pl_ver" ]] && [[ "$(printf '0.9.0\n%s\n' "$pl_ver" | sort -V | head -1)" == "0.9.0" ]]; then
        printf "  {{green}}✓{{nc}} play_launch %s (>= 0.9.0)\n" "$pl_ver"
    elif [[ -n "$pl_ver" ]]; then
        printf "  {{red}}○{{nc}} play_launch %s is below the 0.9.0 floor (run: just play-launch)\n" "$pl_ver"
    else
        printf "  {{red}}○{{nc}} play_launch not installed (run: just play-launch)\n"
    fi
    # Read the version rather than a marker. A marker says this ran once; a
    # JetPack OTA can put 4.8.0 back afterwards, and then the marker is a lie.
    opencv_dev=$(dpkg-query -W -f='${Version}' libopencv-dev 2>/dev/null || true)
    if [[ "$opencv_dev" == 4.5.4* && -f /usr/include/opencv4/opencv2/aruco.hpp ]]; then
        printf "  {{green}}✓{{nc}} opencv %s, headers and runtime agree, contrib present\n" "$opencv_dev"
    elif [[ "$opencv_dev" == 4.8.0* ]]; then
        printf "  {{red}}○{{nc}} opencv %s headers over a 4.5.4 runtime (run: just opencv)\n" "$opencv_dev"
    elif [[ -n "$opencv_dev" ]]; then
        printf "  {{yellow}}○{{nc}} opencv %s, no contrib headers (run: just opencv-check)\n" "$opencv_dev"
    else
        printf "  {{yellow}}○{{nc}} opencv not installed\n"
    fi
    # Autoware data farm: the packaged tree is root-owned, so without this
    # TensorRT cannot cache an engine.
    if [[ -d "{{data_dir}}/autoware_data" ]]; then
        printf "  {{green}}✓{{nc}} autoware-data (writable model tree)\n"
        # Engines, not a marker: they are tied to the TensorRT version and the
        # GPU, so an upgrade invalidates them while any marker would survive.
        engines=$(find "{{data_dir}}/autoware_data" -name '*.engine' -type f 2>/dev/null | wc -l)
        if [[ "$engines" -gt 0 ]]; then
            printf "  {{green}}✓{{nc}} tensorrt-engines (%s built)\n" "$engines"
        else
            printf "  {{yellow}}○{{nc}} tensorrt-engines (none; first launch compiles them inline — run: just build-engines)\n"
        fi
    else
        printf "  {{yellow}}○{{nc}} autoware-data (run: just autoware-data)\n"
    fi
    echo ""
    echo "Optional Downloads:"
    # Check artifacts
    if [[ -f "{{marker_dir}}/artifacts" ]]; then
        printf "  {{green}}✓{{nc}} ML model artifacts\n"
    else
        printf "  {{yellow}}○{{nc}} ML model artifacts (run: just download-artifacts)\n"
    fi
    # Check ZED SDK installation
    if [[ -d "/usr/local/zed" ]] || command -v ZED_Explorer &> /dev/null; then
        printf "  {{green}}✓{{nc}} ZED SDK (installed)\n"
    else
        printf "  {{yellow}}○{{nc}} ZED SDK (not installed - run: just install-zed-sdk)\n"
    fi
    # Check TurboVNC/VirtualGL installation
    if command -v vglrun &> /dev/null && [[ -d "/opt/TurboVNC" ]]; then
        printf "  {{green}}✓{{nc}} TurboVNC + VirtualGL (installed)\n"
    else
        printf "  {{yellow}}○{{nc}} TurboVNC + VirtualGL (run: just turbovnc-virtualgl)\n"
    fi
