# AutoSDV Setup Configuration
# Source this file or set these environment variables before running setup

# ROS 2 Distribution
ROSDISTRO=humble

# ROS 2 Installation Type (desktop, ros-base)
ROS2_INSTALLATION_TYPE=desktop

# RMW Implementation
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# CUDA/TensorRT versions (for reference, installed via Autoware Debian)
# AMD64
CUDA_VERSION_AMD64=12.3
CUDNN_VERSION_AMD64=8.9.5.29-1+cuda12.2
TENSORRT_VERSION_AMD64=8.6.1.6-1+cuda12.0

# ARM64 (Jetson)
CUDNN_VERSION_ARM64=8.9.6.50-1+cuda12.2
TENSORRT_VERSION_ARM64=8.6.2.2-1+cuda12.0

# Pre-commit clang-format version
PRE_COMMIT_CLANG_FORMAT_VERSION=17.0.5
