[Unit]
Description=Synchronize Robin-W PHC from the Jetson system clock
Documentation=man:phc2sys
# Wants, not Requires. ptp4l's first start at boot can fail (it waits up to 60 s
# for chrony), and under Requires that marks this unit "dependency failed" for
# good: ptp4l's Restart= brings ptp4l back, but nothing starts this one again.
# The PHC then free-runs on UTC, while PTP time is TAI, so the Robin-W
# subtracts the 37 s UTC offset from a clock that never had it, and every cloud
# is stamped 37 s in the past (2026-11-06, car B). -w already waits for ptp4l.
Wants=ptp4l.service
After=ptp4l.service
After=network-online.target
Before=time-sync.target
BindsTo=sys-subsystem-net-devices-eno1.device
ConditionPathExists=/sys/class/net/eno1

[Service]
Type=simple
ExecStart=/usr/sbin/phc2sys -f /etc/linuxptp/autosdv-robin-w-phc2sys.conf -s CLOCK_REALTIME -c eno1 -z /var/run/ptp4l -w -m -q
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
